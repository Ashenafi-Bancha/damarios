# Where the Express API runs. Used for server-side fetches and for the /api proxy.
# Production (DigitalOcean) sets it to the API's private address automatically, see .do/app.yaml.
BACKEND_URL=http://localhost:4000

# The public address, for search engines and link previews (production: https://damariosgarment.com).
# NEXT_PUBLIC_SITE_URL=https://damariosgarment.com

# Demo mode (no API or database), used for the Vercel preview. Turns on by itself on Vercel without BACKEND_URL.
# NEXT_PUBLIC_DEMO=true
