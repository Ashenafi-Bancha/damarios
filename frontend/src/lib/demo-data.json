   "about": {
    "id": "cmw9n3qnl000qtpdkz5oii73c",
    "section": "about",
    "lang": "en",
    "headline": "Ethiopian weaving, *made modern*.",
    "body": "Ethiopia has a rich weaving heritage and a great potential that is still largely untapped. DaMarios was founded to take this beautiful, overlooked handcraft to a higher level by blending it with modern design. Working with the natural talent and skill of local weavers, we make quality products that meet today’s fashion, and our training center passes these skills on to the next generation. Our work keeps our cultural heritage alive, creates better jobs and income for our artisans, and carries Ethiopia’s name onto the international stage.",
    "visible": true,
    "data": null
   },
   "vision": {
    "id": "sc_vision_en",
    "section": "vision",
    "lang": "en",
    "headline": "From the loom *to the world*.",
    "body": "Our vision is to transform Ethiopia’s under-valued weaving sector into a modern, high-quality creative industry that is ready for the international market.",
    "visible": true,
    "data": null
   },
