# Copy this file to .env and fill in the values (local development).
# In production these are set in the DigitalOcean control panel (see .do/app.yaml and DEPLOY.md).

# PostgreSQL connection. With the included docker-compose.yml use:
# postgresql://damarios:damarios@localhost:5436/damarios?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/damarios?schema=public"

PORT=4000

# Long random string used to sign login tokens (production: 32+ characters, e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-string"

# Website addresses allowed to call the API from a browser, comma separated.
FRONTEND_URL="http://localhost:3000"

# First owner account, created by `npm run db:seed`.
SEED_OWNER_EMAIL="owner@damarios.local"
SEED_OWNER_PASSWORD="change-me-now"

# Uploaded photos: leave all SPACES_* empty to keep them in the local uploads/ folder.
# Production uses DigitalOcean Spaces: set all four (plus the public address of the bucket).
SPACES_ENDPOINT=""
SPACES_BUCKET=""
SPACES_KEY=""
SPACES_SECRET=""
SPACES_PUBLIC_URL=""

# Optional: Telegram bot that alerts the owner about new requests.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
