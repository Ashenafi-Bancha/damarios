# Copy this file to .env and fill in the values.

# PostgreSQL connection. With the included docker-compose.yml use:
# postgresql://damarios:damarios@localhost:5436/damarios?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/damarios?schema=public"

PORT=4000

# Long random string used to sign login tokens. Change it in production.
JWT_SECRET="change-me-to-a-long-random-string"

# The frontend address (for CORS).
FRONTEND_URL="http://localhost:3000"

# First owner account, created by `npm run db:seed`.
SEED_OWNER_EMAIL="owner@damarios.local"
SEED_OWNER_PASSWORD="change-me-now"

# Optional: Telegram bot that alerts the owner about new requests.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
